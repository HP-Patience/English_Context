generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  interests String?  @default("[]") // JSON array
  llmConfig   String?   // JSON: { baseURL, apiKey, model }
  dailyTarget Int       @default(30)
  ttsConfig   String?  @default("{}") // JSON: { provider, baseURL, apiKey, voice }
  createdAt   DateTime  @default(now())

  words               UserWord[]
  reviewSessions      ReviewSession[]
  storyProgress       UserStoryProgress[]
  storyWordProgress   UserStoryWordProgress[]
  storyReviewAttempts StoryReviewAttempt[]
  storyParagraphCompletions UserStoryParagraphCompletion[]
  storyStepCompletions      UserStoryStepCompletion[]
  storyLessonCompletions    UserStoryLessonCompletion[]
  storyParagraphBookmarks   UserStoryParagraphBookmark[]
}

model Word {
  id       String @id @default(cuid())
  text     String
  phonetic String?
  language String @default("en")

  meanings         Meaning[]
  userWords        UserWord[]
  groups           WordGroupItem[]
  storyLessonWords StoryLessonWord[]
}

model WordGroup {
  id        String @id @default(cuid())
  name      String // e.g. "高频词 Word List 1"
  sortOrder Int
  words        WordGroupItem[]
  storyLessons StoryLesson[]

  @@index([sortOrder])
}

model WordGroupItem {
  id          String @id @default(cuid())
  wordGroupId String
  wordId      String
  sortOrder   Int

  wordGroup WordGroup @relation(fields: [wordGroupId], references: [id])
  word      Word      @relation(fields: [wordId], references: [id])

  @@index([wordGroupId])
  @@index([wordId])
}

model Meaning {
  id           String @id @default(cuid())
  wordId       String
  partOfSpeech String
  definition   String
  definitionCn String? // 中文释义
  example      String?

  word              Word               @relation(fields: [wordId], references: [id])
  generatedSentences GeneratedSentence[]
  userWordMeanings   UserWordMeaning[]
  storyLessonWords   StoryLessonWord[]
}

model StoryCourse {
  id                    String    @id @default(cuid())
  version               Int       @unique
  status                String    @default("draft") // draft | ready | archived | failed
  readySlot             String?   @unique // "ready" only for the single published course; PostgreSQL permits multiple nulls
  sourceFingerprint     String
  summaryFingerprint    String
  outlineFingerprint    String
  assignmentFingerprint String
  generationError       String?
  publishedAt           DateTime?
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lessons StoryLesson[]

  @@index([status])
  @@index([createdAt])
}

model StoryLesson {
  id                 String   @id @default(cuid())
  courseId           String
  order              Int
  title              String
  wordGroupId        String?
  sourceChapterStart String
  sourceChapterEnd   String
  sourceSummary      String
  continuityNotes    String
  contentJson        String   @default("{}")
  status             String   @default("draft") // draft | ready | failed
  generationError    String?
  generatedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course       StoryCourse         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  wordGroup    WordGroup?          @relation(fields: [wordGroupId], references: [id])
  words        StoryLessonWord[]
  userProgress UserStoryProgress[]
  paragraphCompletions UserStoryParagraphCompletion[]
  stepCompletions      UserStoryStepCompletion[]
  lessonCompletions    UserStoryLessonCompletion[]
  paragraphBookmarks   UserStoryParagraphBookmark[]

  @@unique([courseId, order])
  @@index([courseId, status])
  @@index([wordGroupId])
}

model StoryLessonWord {
  id        String   @id @default(cuid())
  lessonId  String
  wordId    String
  meaningId String
  sortOrder Int
  glossCn   String
  createdAt DateTime @default(now())

  lesson StoryLesson @relation(fields: [lessonId], references: [id])
  word    Word        @relation(fields: [wordId], references: [id])
  meaning Meaning     @relation(fields: [meaningId], references: [id])

  userProgress   UserStoryWordProgress[]
  reviewAttempts StoryReviewAttempt[]

  @@unique([lessonId, wordId])
  @@index([lessonId, sortOrder])
  @@index([wordId])
  @@index([meaningId])
}

model UserStoryProgress {
  id               String    @id @default(cuid())
  userId           String
  lessonId         String
  currentStep      Int       @default(1) // 1 | 2 | 3 | 4
  status           String    @default("not_started") // not_started | learning | first_passed | reviewing | reinforced
  step1CompletedAt DateTime?
  step2CompletedAt DateTime?
  step3CompletedAt DateTime?
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  user   User        @relation(fields: [userId], references: [id])
  lesson StoryLesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model UserStoryParagraphCompletion {
  id             String   @id @default(cuid())
  completionId   String
  userId         String
  lessonId       String
  paragraphIndex Int
  step           Int      @default(1)
  completionDate DateTime @db.Date
  createdAt      DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id])
  lesson StoryLesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, completionId])
  @@index([userId, lessonId, step, paragraphIndex])
  @@index([lessonId, completionDate])
}

model UserStoryStepCompletion {
  id             String   @id @default(cuid())
  completionId   String
  userId         String
  lessonId       String
  step           Int
  completionDate DateTime @db.Date
  createdAt      DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id])
  lesson StoryLesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, completionId])
  @@index([userId, lessonId, step])
  @@index([lessonId, completionDate])
}

model UserStoryLessonCompletion {
  id             String   @id @default(cuid())
  completionId   String
  userId         String
  lessonId       String
  completionDate DateTime @db.Date
  createdAt      DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id])
  lesson StoryLesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, completionId])
  @@index([userId, lessonId])
  @@index([lessonId, completionDate])
}

model UserStoryParagraphBookmark {
  id             String   @id @default(cuid())
  userId         String
  lessonId       String
  paragraphIndex Int
  createdAt      DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id])
  lesson StoryLesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId, paragraphIndex])
  @@index([lessonId, paragraphIndex])
}

model UserStoryWordProgress {
  id                   String    @id @default(cuid())
  userId               String
  lessonWordId         String
  reviewRoundCompleted Int       @default(0) // 0-5
  nextReviewAt         DateTime?
  lastResult           String?   // remembered | vague | forgotten
  lastReviewedAt       DateTime?

  user       User            @relation(fields: [userId], references: [id])
  lessonWord StoryLessonWord @relation(fields: [lessonWordId], references: [id])

  @@unique([userId, lessonWordId])
  @@index([nextReviewAt])
  @@index([lessonWordId])
}

model StoryReviewAttempt {
  id           String   @id @default(cuid())
  userId       String
  lessonWordId String
  round                  Int       // 1-5
  result                 String    // remembered | vague | forgotten
  nextReviewAt           DateTime?
  grade                  Int?
  userWordMeaningMastery Float?
  userWordMastery        Float?
  createdAt              DateTime  @default(now())

  user       User            @relation(fields: [userId], references: [id])
  lessonWord StoryLessonWord @relation(fields: [lessonWordId], references: [id])

  @@unique([userId, lessonWordId, round])
  @@index([lessonWordId])
  @@index([createdAt])
}

model UserWord {
  id        String   @id @default(cuid())
  userId    String
  wordId    String
  status    String   @default("learning") // learning | reviewing | mastered
  mastery   Float    @default(0) // 0-100, aggregated from sub-meanings
  bookmarked Boolean @default(false)
  learnRound Int     @default(0) // 0=initial, 1=round1 done, 2=round2, etc.
  lastRatedAt DateTime?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  word    Word    @relation(fields: [wordId], references: [id])
  meanings UserWordMeaning[]

  @@unique([userId, wordId])
}

model UserWordMeaning {
  id              String   @id @default(cuid())
  userWordId      String
  meaningId       String
  easeFactor      Float    @default(2.5)
  interval        Int      @default(0) // days
  nextReviewAt    DateTime @default(now())
  currentTestLevel Int     @default(0) // 0-3
  mastery         Float    @default(0) // 0-100
  lastRatedAt     DateTime?

  userWord     UserWord           @relation(fields: [userWordId], references: [id])
  meaning       Meaning            @relation(fields: [meaningId], references: [id])
  reviewLogs    ReviewLog[]
  sentences     GeneratedSentence[]

  @@index([userWordId, nextReviewAt])
}

model GeneratedSentence {
  id            String   @id @default(cuid())
  userWordMeaningId String
  meaningId     String
  sentenceText  String
  sentenceCn    String?  // 中文翻译
  contextTopic  String?  // general, interest_tuned, synonym_test
  interestTuned Boolean  @default(false)
  source        String   @default("learning") // learning | synonym_test
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())

  userWordMeaning UserWordMeaning @relation(fields: [userWordMeaningId], references: [id])
  meaning         Meaning         @relation(fields: [meaningId], references: [id])
}

model ReviewSession {
  id        String   @id @default(cuid())
  userId    String
  startedAt DateTime @default(now())
  endedAt   DateTime?

  user  User        @relation(fields: [userId], references: [id])
  logs  ReviewLog[]
}

model ReviewLog {
  id                  String   @id @default(cuid())
  reviewSessionId     String
  userWordMeaningId   String
  sentenceText        String
  testLevel           Int      // 1 | 2 | 3
  isSynonymTest       Boolean  @default(false)
  synonymWord         String?
  result              String   // pass | fail
  createdAt           DateTime @default(now())

  reviewSession   ReviewSession   @relation(fields: [reviewSessionId], references: [id])
  userWordMeaning UserWordMeaning @relation(fields: [userWordMeaningId], references: [id])

  @@index([reviewSessionId])
  @@index([userWordMeaningId])
  @@index([createdAt])
  @@index([reviewSessionId, createdAt])
}

model DailyGoal {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  target    Int
  learned   Int      @default(0)
  reviewed  Int      @default(0)
  completed Boolean  @default(false)

  @@unique([userId, date])
  @@index([userId])
}
