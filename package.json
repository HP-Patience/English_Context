{
  "name": "english_context",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3456",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "test:story": "node -e \"const { spawnSync } = require('node:child_process'); const files = process.argv.slice(1); const targets = files.length ? files : ['scripts/test/**/*.test.mjs']; const result = spawnSync(process.execPath, ['--test', ...targets], { stdio: 'inherit' }); process.exit(result.status ?? 1)\"",
    "story:parse": "node scripts/parse-novel.mjs",
    "story:outline": "node scripts/build-story-outline.mjs",
    "story:generate": "node scripts/generate-story-lessons.mjs",
    "story:validate": "node scripts/validate-story-lessons.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/client": "^5.22.0",
    "@serwist/next": "^9.5.11",
    "next": "16.2.9",
    "openai": "^6.42.0",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
